# ========================================================
# ACE (Autonomous Cognitive Engine) - Environment Variables
# Copy this file to .env and fill in your own API keys.
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL.
# ========================================================

# Model provider for all agent steps: jarvislabs (default) | gemma | groq
RESEARCH_MODEL_PROVIDER=jarvislabs

# Jarvislabs Token Factory (Primary Cognitive Model, OpenAI-compatible)
JARVISLABS_API_KEY=your_jarvislabs_api_key_here
JARVISLABS_MODEL=gemma-4-26b-a4b-it
# JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1
# JARVISLABS_MAX_TOKENS=8192
# JARVISLABS_STRUCTURED_MAX_TOKENS=4096

# Google GenAI / Gemma 4 Model (used when RESEARCH_MODEL_PROVIDER=gemma)
GOOGLE_API_KEY=your_google_api_key_here
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it

# Groq API (Optional fallback model)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq:qwen/qwen3.8-27b

# Tavily API (Web Search for Research Agents)
TAVILY_API_KEY=your_tavily_api_key_here

# Temporal (durable workflow engine)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# LangSmith & LangChain Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=deep_research_from_scratch
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=deep_research_from_scratch
