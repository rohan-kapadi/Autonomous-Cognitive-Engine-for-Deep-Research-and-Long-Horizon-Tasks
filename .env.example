# ========================================================
# ACE (Autonomous Cognitive Engine) - Environment Variables
# Copy this file to .env and fill in your own API keys.
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL.
# ========================================================

# Google GenAI / Gemma 4 Model (Primary Cognitive Model)
GOOGLE_API_KEY=your_google_api_key_here
RESEARCH_MODEL_PROVIDER=gemma
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it

# Groq API (Fast Scoping & Fallback Model)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq:qwen/qwen3.8-27b

# Tavily API (Web Search for Research Agents)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith & LangChain Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ace-temporal-demo
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ace-temporal-demo

# Temporal Durable Execution
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ace-research
TEMPORAL_WORKFLOW_ID_PREFIX=ace-research
TEMPORAL_SCOPING_TIMEOUT=300
TEMPORAL_RESEARCH_TIMEOUT=1800
TEMPORAL_MAX_RETRIES=3
